# YÖNESİST mobil uygulama ortam değişkenleri (Expo). `.env.local` olarak kopyalayın; `.env*` dosyaları
# repoya girmez. EXPO_PUBLIC_* değerleri uygulama paketine GÖMÜLÜR: buraya gizli bilgi (anahtar, şifre) yazmayın.
# Cognito istemci kimliği ve havuz kimliği gizli değildir (web'deki VITE_COGNITO_* ile aynı değerler).

# API Gateway adresi (Terraform `frontend_env` çıktısındaki VITE_API_URL ile aynı). Sonda "/" olmadan.
# Yerel API'yi telefondan denerken bilgisayarın yerel ağ adresini verin (ör. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# cognito (varsayılan) | mock (yalnızca yerel geliştirme; API de AUTH_MODE=mock olmalı; store derlemesinde reddedilir)
EXPO_PUBLIC_AUTH_MODE=mock

# live (varsayılan): gerçek API | demo: API'ye gitmeden örnek veri (yalnızca mock kimlikle; web önizlemesi için)
EXPO_PUBLIC_API_MODE=live

# Cognito (web: VITE_COGNITO_REGION / VITE_COGNITO_USER_POOL_ID / VITE_COGNITO_USER_POOL_CLIENT / VITE_COGNITO_TOKEN_USE)
EXPO_PUBLIC_COGNITO_REGION=eu-north-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT=
# id (LITE / Pre Token V1: rol claim'leri ID token'da) | access
EXPO_PUBLIC_COGNITO_TOKEN_USE=id

# Web uygulamasının adresi: henüz mobilde olmayan ekranlar ve online ödeme uygulama içi tarayıcıda buradan açılır.
EXPO_PUBLIC_WEB_URL=https://building-management-apx.pages.dev

# --- Derleme yapılandırması (app.config.ts; pakete gömülmez, EAS'ta eas.json / EAS ortamından gelir) ---
# Boş bırakılırsa bugünkü değerler: production, com.yonesist.app, proje kimliği app.json'dan.
# APP_VARIANT=development          # development | preview | production (.dev / .preview sonekli paket kimliği)
# APP_BUNDLE_ID=com.yonesist.app   # iOS paket kimliği kökü
# APP_PACKAGE=com.yonesist.app     # Android paket adı kökü
# EAS_PROJECT_ID=                  # eas init çıktısı (push kaydı)
# EXPO_OWNER=                      # Expo hesabı / kuruluş
