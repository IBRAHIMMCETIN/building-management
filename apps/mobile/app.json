{
  "expo": {
    "name": "YÖNESİST",
    "slug": "yonesist",
    "scheme": "yonesist",
    "version": "0.1.0",
    "description": "Bina ve toplu konut yönetim sistemi: sakin, bina görevlisi ve güvenlik uygulaması.",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yonesist.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yonesist.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mark.png",
        "backgroundColor": "#ffffff"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini açmak için Face ID kullanılır (Hesabım'dan açılıp kapatılır)."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/mark-dark.png",
            "backgroundColor": "#09090b"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kapıda misafir geçiş QR kodunu okutmak ve arıza, bakım ve sayaç okumasına fotoğraf eklemek için kamera kullanılır.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kapıda misafir geçiş QR kodunu okutmak ve arıza, bakım ve sayaç okumasına fotoğraf eklemek için kamera kullanılır.",
          "photosPermission": "Arıza, bakım ve sayaç okumasına galeriden fotoğraf eklemek için kullanılır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#122a4e",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ]
  }
}
