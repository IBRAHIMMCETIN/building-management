# `terraform output -json frontend_env` ciktisindaki degerleri .env.local'e kopyalayin.
# Yerelde VITE_API_URL bos kalirsa istekler Vite proxy'si ile http://localhost:3000'e gider.
# Cloudflare Pages'te ayni degiskenler Production + Preview ortamlarina girilir (build aninda gomulur).
VITE_API_URL=
VITE_COGNITO_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT=
# LITE katmani: rol claim'leri yalnizca ID token'da -> "id". ESSENTIALS: "access".
VITE_COGNITO_TOKEN_USE=id

# cognito | mock. mock yalnizca yerel gelistirme icindir (API: AUTH_MODE=mock).
VITE_AUTH_MODE=cognito
