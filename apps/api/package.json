  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@hono/node-server": "^2.1.6",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
